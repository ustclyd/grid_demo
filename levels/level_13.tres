coins = 1
policy = SubResource("south_bouncer")

[resource]
script = ExtResource("level")
title = "13 · 合拍"
play_hint = "同一回合结束时，四块压板都被活棋子占住即可通关
东巡 E4 → D4 → C4 → C3 → D3 → E4
北巡 C2 → C1 → B1 → B2 → C3 → C2 · 折返 A3 ↔ B2"
board_size = Vector2i(5, 4)
player_cell = Vector2i(0, 1)
player_coins = 3
enemies = Array[ExtResource("enemy")]([SubResource("east_enemy"), SubResource("north_enemy"), SubResource("south_enemy")])
pressure_cells = Array[Vector2i]([Vector2i(3, 3), Vector2i(1, 0), Vector2i(1, 1), Vector2i(1, 2)])
optimal_turns = 16
