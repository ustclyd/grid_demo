[gd_resource type="Resource" script_class="PuzzleLevelData" load_steps=11 format=3]

[ext_resource type="Script" path="res://scripts/puzzle/puzzle_level_data.gd" id="level"]
[ext_resource type="Script" path="res://scripts/puzzle/puzzle_enemy_spawn.gd" id="enemy"]
[ext_resource type="Script" path="res://scripts/puzzle/enemies/puzzle_patroller_policy.gd" id="patrol"]
[ext_resource type="Script" path="res://scripts/puzzle/enemies/puzzle_bouncer_policy.gd" id="bouncer"]

[sub_resource type="Resource" id="east_patrol"]
script = ExtResource("patrol")
kind = 3
route = Array[Vector2i]([Vector2i(4, 3), Vector2i(3, 3), Vector2i(2, 3), Vector2i(2, 2), Vector2i(3, 2)])

[sub_resource type="Resource" id="north_patrol"]
script = ExtResource("patrol")
kind = 3
route = Array[Vector2i]([Vector2i(2, 1), Vector2i(2, 0), Vector2i(1, 0), Vector2i(1, 1), Vector2i(2, 2)])

[sub_resource type="Resource" id="south_bouncer"]
script = ExtResource("bouncer")
kind = 2
endpoint_a = Vector2i(0, 2)
endpoint_b = Vector2i(1, 1)

[sub_resource type="Resource" id="east_enemy"]
script = ExtResource("enemy")
cell = Vector2i(4, 3)
coins = 2
