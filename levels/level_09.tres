[resource]
script = ExtResource("1_level")
title = "09 · 六库·往返"
play_hint = "金库「库3→+2」表示恰持 3 币可领 2 币，结算先拾散币
移动或主动待机后留在目标格并生还，就能开库，敌人也能开
守卫待机 · 折返兵往返 E1 / D1 · 警戒兵只追回合开始时相邻的玩家"
board_size = Vector2i(5, 4)
player_cell = Vector2i(3, 1)
player_coins = 3
enemies = Array[ExtResource("2_spawn")]([SubResource("guard_spawn"), SubResource("bouncer_spawn"), SubResource("watcher_spawn")])
bags = Array[ExtResource("6_bag")]([SubResource("loose_c3"), SubResource("vault_a4"), SubResource("vault_b3"), SubResource("vault_c1"), SubResource("vault_c4"), SubResource("vault_d1"), SubResource("vault_d3")])
